views:
  - type: cards
    name: 表格
    filters:
      and:
        - file.tags.contains("读书笔记")
    sort:
      - property: file.name
        direction: ASC
    imageAspectRatio: 0.65
    imageFit: contain
  - type: cards
    name: 视图
    filters:
      and:
        - file.tags.contains("读书笔记")
        - file.hasTag("两性知识")
    order: []
    cardSize: 430
    image: note.aliases
    imageFit: contain
    imageAspectRatio: 0.75
